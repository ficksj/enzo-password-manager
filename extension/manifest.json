{
  "manifest_version": 3,
  "name": "Enzo Passwords",
  "version": "0.1.0",
  "description": "Private browser companion for the Enzo Windows password manager.",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "host_permissions": ["http://127.0.0.1:48152/*", "http://localhost:48152/*"],
  "action": { "default_title": "Enzo Passwords", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
